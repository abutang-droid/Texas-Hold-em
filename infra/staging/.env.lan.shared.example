# 与已有应用共用 Ubuntu（192.168.31.52）— 使用独立端口，避免冲突
# 复制: cp infra/staging/.env.lan.shared.example .env
# 启动: STAGING_SHARED_HOST=1 bash scripts/staging-up.sh

STAGING_SHARED_HOST=1

# Texas Hold'em 专用端口（131xx 段，一般不与常见服务冲突）
API_PORT=13100
ROOM_PORT=13101
ADMIN_PORT=13180

NODE_ENV=staging
PAYMENT_MODE=mock
IAP_SANDBOX_MODE=true
OAUTH_DEV_MODE=true

JWT_SECRET=CHANGE_ME_staging_jwt_secret
ADMIN_API_KEY=CHANGE_ME_admin_key

STAGING_LAN_IP=192.168.31.52
ROOM_SERVER_URL=http://192.168.31.52:13101

# 数据库映射到宿主机 15432（容器内仍是 5432）
DATABASE_URL=postgresql://th:CHANGE_ME_db_pass@localhost:15432/texas_holdem
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_DATABASE=texas_holdem
POSTGRES_USER=th
POSTGRES_PASSWORD=CHANGE_ME_db_pass

# Redis 映射到宿主机 16379
REDIS_URL=redis://localhost:16379

EXPO_PUBLIC_API_URL=http://192.168.31.52:13100
EXPO_PUBLIC_ROOM_URL=http://192.168.31.52:13101

VITE_API_PROXY=http://127.0.0.1:13100
