# Texas Hold'em · Staging (Proxmox LXC + Cloudflare Tunnel)
# 复制到仓库根目录: cp infra/staging/.env.staging.example .env

API_PORT=3000
ROOM_PORT=3001
NODE_ENV=staging

# Staging：模拟支付 + IAP 沙盒收据
PAYMENT_MODE=mock
IAP_SANDBOX_MODE=true
OAUTH_DEV_MODE=true

# 必改 — openssl rand -hex 32
JWT_SECRET=CHANGE_ME_staging_jwt_secret

ROOM_SERVER_URL=https://room-staging.yourdomain.com

DATABASE_URL=postgresql://th:CHANGE_ME_db_pass@localhost:5432/texas_holdem
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=texas_holdem
POSTGRES_USER=th
POSTGRES_PASSWORD=CHANGE_ME_db_pass

REDIS_URL=redis://localhost:6379

# 必改 — openssl rand -hex 16
ADMIN_API_KEY=CHANGE_ME_admin_key

# Expo / 移动端（Mac 开发机 .env 也需同步）
EXPO_PUBLIC_API_URL=https://api-staging.yourdomain.com
EXPO_PUBLIC_ROOM_URL=https://room-staging.yourdomain.com

# Admin Vite 代理目标（LXC 本机 API）
VITE_API_PROXY=http://127.0.0.1:3000

# Cloudflare Tunnel（Zero Trust → Create tunnel → token）
CLOUDFLARE_TUNNEL_TOKEN=

# 上架前再填
# APPLE_IAP_SHARED_SECRET=
# GOOGLE_PLAY_PACKAGE_NAME=com.texasholdem.app
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
