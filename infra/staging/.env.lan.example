# Texas Hold'em · Staging 局域网模式（无公网域名）
# 复制: cp infra/staging/.env.lan.example .env
# 把 192.168.1.50 改成 LXC 实际局域网 IP

API_PORT=3000
ROOM_PORT=3001
NODE_ENV=staging

PAYMENT_MODE=mock
IAP_SANDBOX_MODE=true
OAUTH_DEV_MODE=true

JWT_SECRET=CHANGE_ME_staging_jwt_secret

# LXC 局域网 IP（网段 192.168.31.0/24，网关 192.168.31.1）
STAGING_LAN_IP=192.168.31.50
ROOM_SERVER_URL=http://192.168.31.50:3001

DATABASE_URL=postgresql://th:th_pass@localhost:5432/texas_holdem
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=texas_holdem
POSTGRES_USER=th
POSTGRES_PASSWORD=th_pass

REDIS_URL=redis://localhost:6379

ADMIN_API_KEY=CHANGE_ME_admin_key

# Mac / 手机与 LXC 同一 WiFi 时使用
EXPO_PUBLIC_API_URL=http://192.168.31.50:3000
EXPO_PUBLIC_ROOM_URL=http://192.168.31.50:3001

VITE_API_PROXY=http://127.0.0.1:3000

# 局域网模式不需要
# CLOUDFLARE_TUNNEL_TOKEN=
