# Local development environment
API_PORT=3000
ROOM_PORT=3001
PAYMENT_MODE=mock
JWT_SECRET=dev-secret-change-in-production
ROOM_SERVER_URL=http://localhost:3001

DATABASE_URL=postgresql://th:th_pass@localhost:5432/texas_holdem
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=texas_holdem
POSTGRES_USER=th
POSTGRES_PASSWORD=th_pass

REDIS_URL=redis://localhost:6379

# Admin API (v1.0 back-office)
ADMIN_API_KEY=dev-admin-key-change-in-production

# Expo client (web / device)
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_ROOM_URL=http://localhost:3001

# IAP sandbox (dev receipts: sandbox:apple:{productId} or sandbox:google:{productId})
IAP_SANDBOX_MODE=true
# APPLE_IAP_SHARED_SECRET=
# GOOGLE_PLAY_PACKAGE_NAME=com.texasholdem.app
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# OAuth dev mode (idToken: dev:google:user123 or dev:apple:user123)
OAUTH_DEV_MODE=true
